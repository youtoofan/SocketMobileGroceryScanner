<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:SocketMobileGroceryScanner.Converters"
             x:Class="SocketMobileGroceryScanner.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:IntToBoolConverter x:Key="IntToBoolConverter" />
            <conv:IntToInverseBoolConverter x:Key="IntToInverseBoolConverter" />
            <conv:StringToBoolConverter x:Key="StringToBoolConverter" />
            <conv:BoolToSyncTextConverter x:Key="BoolToSyncTextConverter" />
            <conv:BoolToScanModeTextConverter x:Key="BoolToScanModeTextConverter" />
            <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
            <conv:ScannerStatusToColorConverter x:Key="ScannerStatusToColorConverter" />
            <conv:BoolToTranslateTextConverter x:Key="BoolToTranslateTextConverter" />
            <conv:BoolToFetchImagesTextConverter x:Key="BoolToFetchImagesTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
