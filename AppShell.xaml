<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SocketMobileGroceryScanner.Views"
       x:Class="SocketMobileGroceryScanner.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.TabBarBackgroundColor="#FFFFFF"
       Shell.TabBarTitleColor="#E8603C"
       Shell.TabBarUnselectedColor="#9E8E8E"
       BackgroundColor="#3D1A2E">

    <TabBar>
        <ShellContent Title="Inventory"
                      Icon="icon_inventory.svg"
                      ContentTemplate="{DataTemplate views:InventoryPage}"
                      Route="inventory" />
        <ShellContent Title="Shopping"
                      Icon="icon_cart.svg"
                      ContentTemplate="{DataTemplate views:ShoppingListPage}"
                      Route="shopping" />
        <ShellContent Title="Settings"
                      Icon="icon_settings.svg"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="settings" />
    </TabBar>
</Shell>
