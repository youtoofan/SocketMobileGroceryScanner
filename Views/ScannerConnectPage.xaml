<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SocketMobileGroceryScanner.ViewModels"
             xmlns:svc="clr-namespace:SocketMobileGroceryScanner.Services"
             x:Class="SocketMobileGroceryScanner.Views.ScannerConnectPage"
             x:DataType="vm:ScannerConnectViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource HeaderBg}"
              Padding="16,20" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="‹ Back" TextColor="White"
                    BackgroundColor="Transparent" Padding="8,0"
                    FontSize="16" Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="Scanner Status" FontSize="22"
                       FontAttributes="Bold" TextColor="White" />
                <Label Text="{Binding ConnectionStatusText}" TextColor="#D4A0B0"
                       FontSize="13" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" Padding="16,12">
            <VerticalStackLayout Spacing="16">

                <!-- Error / info message -->
                <Border Style="{StaticResource Card}" Padding="16,12"
                        IsVisible="{Binding HasError}"
                        BackgroundColor="#FFF0EB">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                               FontSize="14" />
                        <Button Text="Open Companion App"
                                Command="{Binding OpenCompanionAppCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <!-- Connected state -->
                <Border Style="{StaticResource Card}" Padding="24,20"
                        IsVisible="{Binding IsConnected}">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Label Text="✅" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="{Binding ConnectionStatusText}" FontSize="18"
                               FontAttributes="Bold" HorizontalOptions="Center" />

                        <!-- Connected devices list -->
                        <Label Text="Connected Scanners:" FontSize="14"
                               TextColor="{StaticResource Muted}"
                               HorizontalOptions="Center"
                               IsVisible="{Binding Devices.Count, Converter={StaticResource IntToBoolConverter}}" />
                        <CollectionView ItemsSource="{Binding Devices}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="svc:BluetoothDeviceInfo">
                                    <Border BackgroundColor="{StaticResource SurfaceVariant}"
                                            Padding="12,8" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8" Margin="0,2">
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="📡" FontSize="18" VerticalOptions="Center" />
                                            <Label Text="{Binding Name}" FontSize="15"
                                                   FontAttributes="Bold" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Test scan section -->
                        <BoxView HeightRequest="1" Color="{StaticResource Border}"
                                 Margin="0,8" />
                        <Label Text="🔍 Test Scan" FontSize="18" FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="Scan any barcode to verify the connection"
                               Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />

                        <!-- Barcode result -->
                        <Border BackgroundColor="{StaticResource SurfaceVariant}"
                                Padding="20,16" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                IsVisible="{Binding HasTestBarcode}">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="✓ Barcode received!" TextColor="{StaticResource Found}"
                                       FontAttributes="Bold" FontSize="15"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding TestBarcode}" FontSize="24"
                                       FontAttributes="Bold" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Waiting indicator -->
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center"
                                             IsVisible="{Binding HasTestBarcode, Converter={StaticResource InverseBoolConverter}}">
                            <ActivityIndicator IsRunning="True" Color="{StaticResource Muted}"
                                               HeightRequest="24" WidthRequest="24"
                                               HorizontalOptions="Center" />
                            <Label Text="Waiting for scan…" Style="{StaticResource MutedLabel}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Connecting state -->
                <Border Style="{StaticResource Card}" Padding="24,20"
                        IsVisible="{Binding IsConnecting}">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" />
                        <Label Text="{Binding ConnectionStatusText}" FontSize="16"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Disconnected state: guidance -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsDisconnected}">

                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="📡 No Scanner Connected" FontSize="18"
                                   FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Style="{StaticResource MutedLabel}" FontSize="14"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   Text="Use the Socket Mobile Companion app to pair and connect your barcode scanner." />

                            <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,4" />

                            <Label Text="Setup Steps:" FontSize="15" FontAttributes="Bold" />
                            <Label FontSize="13" TextColor="{StaticResource Muted}"
                                   Text="1. Install Socket Mobile Companion app" />
                            <Label FontSize="13" TextColor="{StaticResource Muted}"
                                   Text="2. Set scanner to Application Mode (SPP)" />
                            <Label FontSize="13" TextColor="{StaticResource Muted}"
                                   Text="3. Pair scanner via Companion app" />
                            <Label FontSize="13" TextColor="{StaticResource Muted}"
                                   Text="4. Scanner will appear here automatically" />

                            <Button Text="Open Companion App"
                                    Command="{Binding OpenCompanionAppCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalOptions="Fill" Margin="0,8,0,0" />

                            <Button Text="⟳ Retry Connection"
                                    Command="{Binding LoadDevicesCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
