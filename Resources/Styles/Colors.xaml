<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="Primary">#E8603C</Color>
    <Color x:Key="PrimaryDark">#C44A2A</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="HeaderBg">#3D1A2E</Color>
    <Color x:Key="HeaderBgLight">#5C2D45</Color>

    <!-- Surfaces -->
    <Color x:Key="Background">#FFF8F5</Color>
    <Color x:Key="BackgroundDark">#1A1A2E</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#2A2A3E</Color>
    <Color x:Key="SurfaceVariant">#FFF0EB</Color>
    <Color x:Key="SurfaceVariantDark">#3A2A3E</Color>
    <Color x:Key="InputBg">#FFF0EB</Color>

    <!-- Text -->
    <Color x:Key="OnSurface">#1A1A2E</Color>
    <Color x:Key="OnSurfaceDark">#F5F0F0</Color>
    <Color x:Key="Muted">#9E8E8E</Color>
    <Color x:Key="Secondary">#5C2D45</Color>
    <Color x:Key="SecondaryDark">#D4A0B0</Color>

    <!-- Borders -->
    <Color x:Key="Border">#F0E6E6</Color>
    <Color x:Key="BorderDark">#4A3A4E</Color>

    <!-- Semantic -->
    <Color x:Key="Found">#4CAF50</Color>
    <Color x:Key="FoundBackground">#E8F5E9</Color>
    <Color x:Key="Danger">#E53935</Color>

</ResourceDictionary>